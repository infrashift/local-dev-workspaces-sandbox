**/.pki/
**/.secrets/
**/.env
**/__pycache__/
**/.ansible_vault_key*
# The ansible-vault encrypted sudo password (make -f lab-bootstrap.mk become-vault)
**/become.vault.yml
**/become.vault.yml.tmp
# The ansible-vault encrypted gateway credentials (make -f lab-gateway.mk secrets)
**/inventory-host/host_vars/*/vault.yml
**/inventory-host/host_vars/*/vault.yml.tmp

# The project's pinned tools: uv, ruff, Terraform (lab-bootstrap.mk)
/.tools/
/.ruff_cache/

# Python virtual environments (lab-bootstrap.mk venv)
/.ansible-core-*/
# pytest virtual environment (lab-bootstrap-verify.mk venv)
/.pytest/
**/.pytest_cache

# Terraform
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Generated by Terraform at apply time
**/.generated/
**/output-data/

# Ansible collections (lab-bootstrap.mk collections)
/.collections/
