{% for surrogate in sandbox_surrogates_surrogates.values() | selectattr('scheme', 'eq', 'basic') %}
{% set user, password = surrogate.credential.split(':', 1) %}
{% for host in surrogate.target_hosts %}
{% if surrogate.repo is defined %}
https://{{ user | urlencode }}:{{ password | urlencode }}@{{ host }}/{{ surrogate.repo }}
https://{{ user | urlencode }}:{{ password | urlencode }}@{{ host }}/{{ surrogate.repo }}.git
{% else %}
https://{{ user | urlencode }}:{{ password | urlencode }}@{{ host }}
{% endif %}
{% endfor %}
{% endfor %}
