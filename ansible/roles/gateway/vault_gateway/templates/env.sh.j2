# {{ ansible_managed }}
# The operator's CLI environment for the ai-sandbox gateway (concepts/Operator
# Interfaces). Source it, then `vault` and `consul` reach the local Vault and
# Consul on their unix sockets with the operator tokens:
#   . {{ vault_gateway_operator_dir }}/env.sh
# Read-only inspection; changes go through make -f lab-gateway.mk.
for ai_sandbox_env in "{{ vault_gateway_operator_dir }}"/env.d/*.sh; do
  # shellcheck source=/dev/null
  . "$ai_sandbox_env"
done
unset ai_sandbox_env
