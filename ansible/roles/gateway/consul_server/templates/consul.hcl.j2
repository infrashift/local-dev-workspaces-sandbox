# {{ ansible_managed }}
# A single-node lab Consul: the egress allow list's K/V store (concepts/Vault
# and Consul Host Trust). Its HTTP API is a unix socket only, which opens for
# the {{ consul_server_socket_group }} group (services, by their units' SupplementaryGroups) and,
# by ACL, the operators. Server RPC and LAN gossip stay on loopback TCP,
# gossip encrypted (encrypt.hcl beside this file). ACLs on, default deny; DNS,
# gRPC and the WAN pool are off.
datacenter           = "ai-sandbox"
node_name            = "ai-sandbox"
server               = true
bootstrap_expect     = 1
data_dir             = "{{ consul_server_data_dir }}"
bind_addr            = "127.0.0.1"
client_addr          = "127.0.0.1"
advertise_addr       = "127.0.0.1"
disable_update_check = true
log_level            = "INFO"

addresses {
  http = "unix://{{ consul_server_socket }}"
}

# Consul takes the group as a number.
unix_sockets {
  group = "{{ consul_server_socket_gid }}"
  mode  = "0660"
}

ports {
  dns      = -1
  grpc     = -1
  grpc_tls = -1
  serf_wan = -1
}

ui_config {
  enabled = false
}

acl {
  enabled                  = true
  default_policy           = "deny"
  down_policy              = "extend-cache"
  enable_token_persistence = true
}
