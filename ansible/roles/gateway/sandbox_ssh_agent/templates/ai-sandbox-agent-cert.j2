#!/usr/bin/env bash
# {{ ansible_managed }}
# ai-sandbox-agent-cert: have Vault's SSH CA sign the sandbox egress key for
# principal {{ sandbox_ssh_agent_principal }} ({{ sandbox_ssh_agent_ttl }}), then load the key and certificate into the
# dedicated sandbox ssh-agent with the same lifetime. The certificate is the
# only credential the SCP target accepts; it expires on its own.
#   make -f lab-gateway.mk agent-cert
set -euo pipefail

VAULT_SOCKET={{ sandbox_ssh_agent_vault_socket }}
TOKEN_FILE={{ sandbox_ssh_agent_token_file }}
KEY={{ sandbox_ssh_agent_key }}
CERT={{ sandbox_ssh_agent_cert }}
SOCK={{ sandbox_ssh_agent_socket }}
ROLE={{ sandbox_ssh_agent_principal }}
TTL={{ sandbox_ssh_agent_ttl }}

[ -r "$TOKEN_FILE" ] || { echo "No operator token at $TOKEN_FILE: run make -f lab-gateway.mk gateway" >&2; exit 1; }
[ -S "$SOCK" ] || { echo "The sandbox agent is not running: systemctl --user start {{ sandbox_ssh_agent_unit }}" >&2; exit 1; }

# The token travels in a header read from a file descriptor, never argv.
header() { printf 'X-Vault-Token: %s' "$(cat "$TOKEN_FILE")"; }
VAULT=http://localhost
vault() { curl -sf --unix-socket "$VAULT_SOCKET" "$@"; }

# Periodic token: each use renews it.
vault -o /dev/null -X POST -H @<(header) "$VAULT/v1/auth/token/renew-self"

request="$(python3 -c 'import json, sys; print(json.dumps({"public_key": open(sys.argv[1]).read().strip(),
  "valid_principals": sys.argv[2], "ttl": sys.argv[3], "cert_type": "user"}))' "$KEY.pub" "$ROLE" "$TTL")"
response="$(vault -X POST -H @<(header) --data "$request" "$VAULT/v1/{{ sandbox_ssh_agent_ssh_mount }}/sign/$ROLE")"
umask 022
python3 -c 'import json, sys; print(json.load(sys.stdin)["data"]["signed_key"].strip())' <<<"$response" >"$CERT.tmp"
mv "$CERT.tmp" "$CERT"

seconds="$(python3 -c 'import re, sys; units = {"s": 1, "m": 60, "h": 3600, "d": 86400}
print(sum(int(n) * units[u] for n, u in re.findall(r"(\d+)([smhd])", sys.argv[1])))' "$TTL")"
SSH_AUTH_SOCK="$SOCK" ssh-add -q -D 2>/dev/null || true
SSH_AUTH_SOCK="$SOCK" ssh-add -q -t "$seconds" "$KEY"
ssh-keygen -L -f "$CERT" | sed -n 's/^[[:space:]]*Valid: /valid /p'
